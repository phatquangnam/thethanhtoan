rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net - Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /test/{testId} {
      allow read: if isValidId(testId);
    }

    match /users/{userId} {
      allow read, write: if isValidId(userId);

      match /cards/{cardId} {
        allow read, write: if isValidId(userId) && isValidId(cardId);
      }

      match /obligations/{obligationId} {
        allow read, write: if isValidId(userId) && isValidId(obligationId);
      }

      match /payments/{paymentId} {
        allow read, write: if isValidId(userId) && isValidId(paymentId);
      }

      match /config/{configId} {
        allow read, write: if isValidId(userId) && isValidId(configId);
      }

      match /snapshots/{snapshotId} {
        allow read, write: if isValidId(userId) && isValidId(snapshotId);
      }
    }
  }
}
