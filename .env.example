# Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
# Supabase Dashboard > Connect > Transaction pooler (port 6543).
# Secret: set only in Vercel Environment Variables, NEVER prefix with VITE_.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_URL_ENCODED_PASSWORD@YOUR_POOLER_HOST:6543/postgres
